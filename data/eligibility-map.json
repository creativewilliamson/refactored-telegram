{
  "_readme": "Generated by pipeline/offers.py from each offer's eligibility text. A person should read this table and fix the rules if a tag is wrong.",
  "tags": {
    "veteran": "Veterans",
    "active": "Active duty",
    "guard_reserve": "Guard and Reserve",
    "retiree": "Retirees",
    "family": "Spouses and family",
    "gold_star": "Gold Star families",
    "everyone": "Everyone"
  },
  "rules": [
    {
      "pattern": "\\bveterans?\\b",
      "adds": [
        "veteran"
      ],
      "why": "says veterans"
    },
    {
      "pattern": "\\bformer military\\b",
      "adds": [
        "veteran"
      ],
      "why": "former military = veterans"
    },
    {
      "pattern": "\\bactive( duty)?\\b",
      "adds": [
        "active"
      ],
      "why": "says active duty"
    },
    {
      "pattern": "\\bservice members?\\b",
      "adds": [
        "active"
      ],
      "why": "service members = active duty"
    },
    {
      "pattern": "^military\\b",
      "adds": [
        "active"
      ],
      "why": "'Military' = serving members"
    },
    {
      "pattern": "\\breserve\\b",
      "adds": [
        "guard_reserve"
      ],
      "why": "says Reserve"
    },
    {
      "pattern": "\\bguard\\b",
      "adds": [
        "guard_reserve"
      ],
      "why": "says Guard"
    },
    {
      "pattern": "\\bretire(d|es?)\\b",
      "adds": [
        "retiree"
      ],
      "why": "says retirees / retired military"
    },
    {
      "pattern": "(?<!gold star )\\bfamil(y|ies)\\b",
      "adds": [
        "family"
      ],
      "why": "says family / families (not Gold Star)"
    },
    {
      "pattern": "\\bspouses?\\b",
      "adds": [
        "family"
      ],
      "why": "says spouses"
    },
    {
      "pattern": "\\bdependents?\\b",
      "adds": [
        "family"
      ],
      "why": "says dependents"
    },
    {
      "pattern": "\\bgold star\\b",
      "adds": [
        "gold_star"
      ],
      "why": "says Gold Star families"
    },
    {
      "pattern": "\\beveryone\\b|\\ball visitors\\b",
      "adds": [
        "everyone"
      ],
      "why": "open to everyone"
    },
    {
      "phrase": "Exchange-eligible shoppers",
      "adds": [
        "active",
        "guard_reserve",
        "retiree",
        "veteran",
        "family"
      ],
      "why": "Exchange shopping is open to active duty, Guard/Reserve, retirees, dependents and (online) honorably discharged veterans; see source."
    },
    {
      "if": "veteran",
      "adds": [
        "retiree"
      ],
      "why": "military retirees are veterans"
    }
  ],
